# Base de datos SQLite (archivo relativo al directorio prisma/)
DATABASE_URL="file:./dev.db"

# Panel docente (contraseña compartida; no es login por estudiante)
TEACHER_PASSWORD="cambiar-esta-clave"

# Google Sheets API v4 con Service Account
# Copiar la clave privada con \n literales (entre comillas dobles)
GOOGLE_SERVICE_ACCOUNT_EMAIL="cuenta@proyecto.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID="id_del_spreadsheet"
GOOGLE_SHEETS_AUTO_SYNC="false"

# Parámetros del motor de equidad (opcionales; valores por defecto en src/lib/config.ts)
CHOICES_PER_STUDENT="3"
BASE_SLOT_CAPACITY="2"
METRICS_MIN_CELL="3"
